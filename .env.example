# ──────────────────────────────────────────────
# DutaMovie API - Environment Configuration
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_NAME=DutaMovie API
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dutamovie?schema=public

# Redis (Cache & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Upstash Redis (optional, for production)
# REDIS_URL=rediss://default:password@us1-steady-bird-12345.upstash.io:6379

# Scraper Configuration
SCRAPER_BASE_URL=https://example.com
SCRAPER_TIMEOUT=30000
SCRAPER_RETRY_COUNT=3
SCRAPER_RETRY_DELAY=1000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=

# Queue (BullMQ)
QUEUE_CONCURRENCY=5
QUEUE_DEFAULT_JOBS=100

# Cache TTL (in seconds)
CACHE_TTL_LATEST=900
CACHE_TTL_TRENDING=1800
CACHE_TTL_DETAIL=3600
CACHE_TTL_SEARCH=600

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
